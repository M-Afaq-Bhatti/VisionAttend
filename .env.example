# Database Configuration
DATABASE_URL=sqlite:///./visionattend.db
# For PostgreSQL use: postgresql://user:password@localhost:5432/visionattend

# Application Configuration
LOG_LEVEL=INFO
DEVICE=auto  # auto, cpu, cuda

# Computer Vision Configuration
RECOGNITION_THRESHOLD=0.45
LIVENESS_THRESHOLD=0.50

# Attendance Rules
ATTENDANCE_COOLDOWN_MINUTES=5
SNAPSHOT_RETENTION_DAYS=7

# Demo Mode (Bypasses some DB constraints / adds fake data if true)
DEMO_MODE=false
